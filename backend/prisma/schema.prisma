// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model PendingUser {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  firstname                String
  lastname                 String
  email                    String   @unique
  password                 String
  verificationOTP          String   @default("")
  verificationOTPExpiresAt String   @default("")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt
}

model User {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  firstname         String
  lastname          String
  email             String   @unique
  password          String
  resetOTP          String   @default("")
  resetOTPExpiresAt String   @default("")
  isActive          Boolean  @default(true)
  role              Role     @default(CUSTOMER)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  wishes            Wish[]
  cart              Cart?    @relation(fields: [cartId], references: [id])
  cartId            String?  @unique @db.ObjectId
  reviews           Review[]
}

model Category {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String        @unique
  image         String
  subCategories SubCategory[]
  productsIDs   String[]      @db.ObjectId
  products      Product[]     @relation(fields: [productsIDs], references: [id])
  isPopular     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
}

model SubCategory {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  categoryId  String    @db.ObjectId
  category    Category  @relation(fields: [categoryId], references: [id])
  productsIDs String[]  @db.ObjectId
  products    Product[] @relation(fields: [productsIDs], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([name, categoryId])
}

model Product {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  description      String
  price            Int
  brand            String
  colors           String[]
  images           Image[]
  categoriesIDs    String[]      @db.ObjectId
  categories       Category[]    @relation(fields: [categoriesIDs], references: [id])
  subCategoriesIDs String[]      @db.ObjectId
  subCategories    SubCategory[] @relation(fields: [subCategoriesIDs], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  wishes           Wish[]
  cartItems        CartItems[]
  reviews          Review[]
}

model Image {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
}

model Wish {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  productId String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, productId])
}

model Cart {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  user      User?
  cartItems CartItems[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
}

model CartItems {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String   @db.ObjectId
  productId String   @db.ObjectId
  quantity  Int
  color     String
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([cartId, productId, color])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  userId    String   @db.ObjectId
  rate      Float
  text      String
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum Role {
  CUSTOMER
  ADMIN
}
